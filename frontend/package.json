{
  "name": "sicp-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "check:visual-baseline": "node scripts/check-visual-baseline.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "test:unit": "playwright test --config playwright.unit.config.ts"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.2.0"
  }
}
