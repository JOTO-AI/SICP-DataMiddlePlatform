# P02 registry configuration. Supply URLs locally; never commit credentials.
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Local isolated Mock deployment may explicitly use sslmode=disable.
# M0/M1 share one endpoint; S0/S1 share a different endpoint.
# Control uses a separate database on M; logs use a third endpoint.
# No default database, fallback host, or URL query routing overrides.
DATABASE_M0_URL=
DATABASE_M1_URL=
DATABASE_S0_URL=
DATABASE_S1_URL=
DATABASE_CONTROL_URL=
DATABASE_LOG_URL=
