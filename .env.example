# 统一部署配置：首次复制为根目录 .env，再修改 .env；不要提交真实凭据。
# 仅运行本地 Mock 演示：以下默认值全部可以保留，synthetic 是公开的演示密码。
# [正式必改]：正式部署时必须替换；[按需修改]：按实际环境调整；[默认保留]：内置 Compose 可直接使用。
# 本文件的标注不代表改完密码就完成生产部署；真实源、邮件、TLS、存储等要求见 deploy/README.md。
# Compose dotenv 语法：含字面量 $ 或 # 的值使用单引号；JSON 保持单行。
# 数据库密码仅在下方四个 *_PASSWORD 中填写一次，服务自动复用并处理 URL 特殊字符编码。
# 下方 DATABASE_*_URL 只填写端点与库名，不要写入用户名或密码。
# 已有数据库卷不会因修改 .env 而自动改密码；应先在数据库内修改对应角色密码，再同步配置。

# [按需修改] 项目名与宿主机端口；无冲突可保留。改项目名会使用另一套命名卷。
SICP_PROJECT=sicp-phase1
SICP_QUERY_PORT=18080
SICP_WORKER_PORT=18081
SICP_CONSOLE_PORT=18082

# PostgreSQL 首次建库配置：仅在空数据库卷初始化时应用。
# [默认保留] 管理员用户名；迁移工具自动复用。
POSTGRES_USER=postgres
# [正式必改] 管理员密码；首次建库和迁移工具的全部连接自动复用。
POSTGRES_PASSWORD=synthetic
# [正式必改] sicp_query 密码；查询服务的业务库和 control 连接自动复用。
QUERY_PASSWORD=synthetic
# [正式必改] sicp_worker 密码；同步服务的业务库和 control 连接自动复用。
WORKER_PASSWORD=synthetic
# [正式必改] sicp_logger 密码；query / worker 的日志连接自动复用。
# 迁移工具的日志连接自动使用管理员密码。
LOGGER_PASSWORD=synthetic

# query / worker 公共配置
# [按需修改] 源时间解析时区与超时；当前默认值可用于本地演示。
SOURCE_TIMEZONE=Asia/Shanghai
STARTUP_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s
DEPENDENCY_TIMEOUT=10s
# [正式必改] 业务查询密钥；控制台“业务密钥”也填写此值，不要与管理令牌共用。
QUERY_API_KEY=synthetic-query-secret
# [默认保留] 内置 Redis 地址；使用外部 Redis 时按实际地址调整。
REDIS_URL=redis://redis:6379/0
# [默认保留] 容器内日志目录，已挂载持久卷；改路径须同步 compose.yaml 的挂载目标。
LOG_DIRECTORY=/var/lib/sicp/logs
# [按需修改] 日志容量与文件数；正式部署按实际日志规模设置。
LOG_MAX_BYTES=67108864
LOG_MAX_FILES=10000
# [正式必改] 两个独立的随机秘密，各至少 32 字节，彼此不同且不能等于 QUERY_API_KEY。
# 配置在 query / worker 间共享；正常重启时保留，勿每次启动重新生成。
SNAPSHOT_KEY=synthetic-snapshot-key-0000000000
AUDIT_KEY=synthetic-audit-key-0000000000000
# [正式必改] 填写实际发布版本标识，例如提交号或版本号。
CODE_VERSION=phase1-synthetic
# [正式必改] 正式环境使用 production；可选 test/development/staging/production。
# production 不允许 MAIL_TLS=none，须同时配置真实邮件服务及 TLS。
ENVIRONMENT=test

# [默认保留] 共享数据库端点：三种服务连接同一批数据库，各自账号由 Compose 自动分配。
# 内置 Compose 的 db-m/db-s/db-log、5432、库名无需改为宿主机地址；URL 不包含凭据。
# [按需修改] 外部数据库才调整端点；TLS 参数按实际部署设置，verify-full 需要证书配置配合。
DATABASE_M0_URL=postgres://db-m:5432/slot0?sslmode=disable
DATABASE_M1_URL=postgres://db-m:5432/slot1?sslmode=disable
DATABASE_S0_URL=postgres://db-s:5432/slot0?sslmode=disable
DATABASE_S1_URL=postgres://db-s:5432/slot1?sslmode=disable
DATABASE_CONTROL_URL=postgres://db-m:5432/control?sslmode=disable
DATABASE_LOG_URL=postgres://db-log:5432/logs?sslmode=disable

# worker 的文件、数据源、邮件和管理配置
# [默认保留] 三个容器内目录已有持久卷；改路径须同步 compose.yaml 的挂载目标。
STAGING_DIRECTORY=/var/lib/sicp/staging
TARGET_DIRECTORY=/var/lib/sicp/targets
SPOOL_DIRECTORY=/var/lib/sicp/spool
# [按需修改] 下面是小规模合成数据预算，正式部署需按全量数据及临时空间需求设置。
STAGING_MAX_BYTES=268435456
TARGET_MAX_BYTES=268435456
SPOOL_MAX_BYTES=134217728
# [正式必改] 真实源系统的 origin（协议、主机、端口，不含接口路径）及访问令牌。
# 本地演示保留 Mock 地址；SOURCE_TOKEN 同时传给 Mock 与 worker，无需另改 Mock 凭据。
SOURCE_ORIGIN=http://mock-source:8090
SOURCE_TOKEN=synthetic-source-token
# [正式必改] 实际数据源范围标识，部署后保持稳定。
SOURCE_SCOPE=synthetic-sicp-source
# [正式必改] 按真实 14 张源表的数据规模设定质量门禁，不应直接沿用演示阈值。
SOURCE_QUALITY={"dwd_bzksbjsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkscjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzksgrtxsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzksjbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkskbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkskcsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzksnjzysjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkspksjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzksxjjbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkszyxxsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_grtxfszlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_jzgjcsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_xqjbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_yxsdwjbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false}}
# [正式必改] 实际 SMTP 地址、TLS 模式（tls/starttls/none）及真实发件/收件地址。
# 当前 Mock 只在本地收信；若 SMTP 要求登录，还需在 Compose 的 worker 中传入 MAIL_USERNAME/MAIL_PASSWORD。
MAIL_ADDRESS=mock-mail:1025
MAIL_TLS=none
MAIL_FROM=worker@example.invalid
MAIL_TO=operator@example.invalid
# [正式必改] 将 operator 改为实际操作者标识，token 改为独立随机管理令牌，actions 按授权范围设置。
# 下方 MANAGEMENT_TOKEN 和控制台“管理令牌”必须与这里某个 token 一致。
MANAGEMENT_CREDENTIALS=[{"operator":"synthetic-admin","token":"synthetic-management-token","actions":["initialize","sync","force_full","rerun","status"]}]

# 命令行管理工具
# [默认保留] Compose 内部的 worker 地址；宿主机端口变化不需要修改这里。
MANAGEMENT_URL=http://worker:8081
# [同步修改] 与 MANAGEMENT_CREDENTIALS 中已授权的 token 保持一致，正式部署替换演示值。
MANAGEMENT_TOKEN=synthetic-management-token

# [仅 Mock 使用] 本地演示可保留；在共享测试环境保留 Mock 时应更换为独立随机令牌。
MOCK_CONTROL_TOKEN=synthetic-mock-control-token
