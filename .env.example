# Unified Docker Compose configuration. Copy this file to .env before deployment.
# Synthetic local defaults only. Do not commit .env or real credentials.
# Compose dotenv syntax: single-quote values containing literal $ or #.
# Passwords inside PostgreSQL URLs must be percent-encoded; keep URLs and role passwords in sync.

# Project and host ports
SICP_PROJECT=sicp-phase1
SICP_QUERY_PORT=18080
SICP_WORKER_PORT=18081
SICP_CONSOLE_PORT=18082

# PostgreSQL bootstrap (only applied to empty volumes)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=synthetic
QUERY_PASSWORD=synthetic
WORKER_PASSWORD=synthetic
LOGGER_PASSWORD=synthetic

# Shared query / worker runtime
SOURCE_TIMEZONE=Asia/Shanghai
STARTUP_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s
DEPENDENCY_TIMEOUT=10s
QUERY_API_KEY=synthetic-query-secret
REDIS_URL=redis://redis:6379/0
LOG_DIRECTORY=/var/lib/sicp/logs
LOG_MAX_BYTES=67108864
LOG_MAX_FILES=10000
SNAPSHOT_KEY=synthetic-snapshot-key-0000000000
AUDIT_KEY=synthetic-audit-key-0000000000000
CODE_VERSION=phase1-synthetic
ENVIRONMENT=test

# query database connections
QUERY_DATABASE_M0_URL=postgres://sicp_query:synthetic@db-m:5432/slot0?sslmode=disable
QUERY_DATABASE_M1_URL=postgres://sicp_query:synthetic@db-m:5432/slot1?sslmode=disable
QUERY_DATABASE_S0_URL=postgres://sicp_query:synthetic@db-s:5432/slot0?sslmode=disable
QUERY_DATABASE_S1_URL=postgres://sicp_query:synthetic@db-s:5432/slot1?sslmode=disable
QUERY_DATABASE_CONTROL_URL=postgres://sicp_query:synthetic@db-m:5432/control?sslmode=disable
QUERY_DATABASE_LOG_URL=postgres://sicp_logger:synthetic@db-log:5432/logs?sslmode=disable

# worker database connections
WORKER_DATABASE_M0_URL=postgres://sicp_worker:synthetic@db-m:5432/slot0?sslmode=disable
WORKER_DATABASE_M1_URL=postgres://sicp_worker:synthetic@db-m:5432/slot1?sslmode=disable
WORKER_DATABASE_S0_URL=postgres://sicp_worker:synthetic@db-s:5432/slot0?sslmode=disable
WORKER_DATABASE_S1_URL=postgres://sicp_worker:synthetic@db-s:5432/slot1?sslmode=disable
WORKER_DATABASE_CONTROL_URL=postgres://sicp_worker:synthetic@db-m:5432/control?sslmode=disable
WORKER_DATABASE_LOG_URL=postgres://sicp_logger:synthetic@db-log:5432/logs?sslmode=disable

# migrate database connections
MIGRATE_DATABASE_M0_URL=postgres://postgres:synthetic@db-m:5432/slot0?sslmode=disable
MIGRATE_DATABASE_M1_URL=postgres://postgres:synthetic@db-m:5432/slot1?sslmode=disable
MIGRATE_DATABASE_S0_URL=postgres://postgres:synthetic@db-s:5432/slot0?sslmode=disable
MIGRATE_DATABASE_S1_URL=postgres://postgres:synthetic@db-s:5432/slot1?sslmode=disable
MIGRATE_DATABASE_CONTROL_URL=postgres://postgres:synthetic@db-m:5432/control?sslmode=disable
MIGRATE_DATABASE_LOG_URL=postgres://postgres:synthetic@db-log:5432/logs?sslmode=disable

# Worker source, storage, mail and management
STAGING_DIRECTORY=/var/lib/sicp/staging
TARGET_DIRECTORY=/var/lib/sicp/targets
SPOOL_DIRECTORY=/var/lib/sicp/spool
STAGING_MAX_BYTES=268435456
TARGET_MAX_BYTES=268435456
SPOOL_MAX_BYTES=134217728
SOURCE_ORIGIN=http://mock-source:8090
SOURCE_TOKEN=synthetic-source-token
SOURCE_SCOPE=synthetic-sicp-source
SOURCE_QUALITY={"dwd_bzksbjsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkscjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzksgrtxsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzksjbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkskbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkskcsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzksnjzysjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkspksjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzksxjjbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_bzkszyxxsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_grtxfszlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_jzgjcsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_xqjbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false},"dwd_yxsdwjbsjzlb":{"MinimumRows":1,"MaximumDeletedRows":1000,"AllowEmpty":false}}
MAIL_ADDRESS=mock-mail:1025
MAIL_TLS=none
MAIL_FROM=worker@example.invalid
MAIL_TO=operator@example.invalid
MANAGEMENT_CREDENTIALS=[{"operator":"synthetic-admin","token":"synthetic-management-token","actions":["initialize","sync","force_full","rerun","status"]}]

# CLI management (token must match a worker MANAGEMENT_CREDENTIALS entry)
MANAGEMENT_URL=http://worker:8081
MANAGEMENT_TOKEN=synthetic-management-token

# Mock control API
MOCK_CONTROL_TOKEN=synthetic-mock-control-token
