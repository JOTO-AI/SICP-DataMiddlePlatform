# Expected synthetic runtime for assembly tests; configure deployment in root .env.
HTTP_ADDRESS=0.0.0.0:8080
SOURCE_TIMEZONE=Asia/Shanghai
STARTUP_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s
DEPENDENCY_TIMEOUT=10s
QUERY_API_KEY=synthetic-query-secret
REDIS_URL=redis://redis:6379/0
LOG_DIRECTORY=/var/lib/sicp/logs
LOG_MAX_BYTES=67108864
LOG_MAX_FILES=10000
SNAPSHOT_KEY=synthetic-snapshot-key-0000000000
AUDIT_KEY=synthetic-audit-key-0000000000000
ENVIRONMENT=test
DATABASE_M0_URL=postgres://sicp_query:synthetic@db-m:5432/slot0?sslmode=disable
DATABASE_M1_URL=postgres://sicp_query:synthetic@db-m:5432/slot1?sslmode=disable
DATABASE_S0_URL=postgres://sicp_query:synthetic@db-s:5432/slot0?sslmode=disable
DATABASE_S1_URL=postgres://sicp_query:synthetic@db-s:5432/slot1?sslmode=disable
DATABASE_CONTROL_URL=postgres://sicp_query:synthetic@db-m:5432/control?sslmode=disable
LOG_STORAGE_MODE=single_legacy
DATABASE_LOG_URL=postgres://sicp_logger:synthetic@db-log:5432/logs?sslmode=disable
